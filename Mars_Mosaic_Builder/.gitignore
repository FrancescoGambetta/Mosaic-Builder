# Project specific
# Ignore all common image formats (case-insensitive)
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[bB][mM][pP]
*.[gG][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[rR][aA][wW]

# Keep input_images folder in git with only .gitkeep
input_images/*
!input_images/.gitkeep

